# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Paystack (also used to verify webhook signatures — Paystack has no separate webhook secret)
PAYSTACK_SECRET_KEY=

# Cloudinary (skip if using Supabase Storage instead)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (order confirmations) — using Gmail SMTP.
# EMAIL_PASSWORD must be a Gmail App Password, not your account password:
# Google Account > Security > 2-Step Verification > App Passwords.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Where new-order notifications are sent (the shop owner's inbox, not
# necessarily the same address EMAIL_USER sends from).
ADMIN_NOTIFICATION_EMAIL=

# Error monitoring (optional) — leave blank to disable. Create a free
# project at sentry.io (separate from the client's) and paste its DSN here.
SENTRY_DSN=
