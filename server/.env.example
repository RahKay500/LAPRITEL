# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Paystack (also used to verify webhook signatures — Paystack has no separate webhook secret)
PAYSTACK_SECRET_KEY=

# Cloudinary (skip if using Supabase Storage instead)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (order confirmations, etc.)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
