# Base URL for API requests. Leave as /api in development — vite.config.js
# proxies it to the backend. Set to the full backend URL in production.
VITE_API_BASE_URL=/api

# Paystack public key (safe to expose in the browser, unlike the secret key)
VITE_PAYSTACK_PUBLIC_KEY=

# Error monitoring (optional) — leave blank to disable. Create a free
# project at sentry.io and paste its DSN here.
VITE_SENTRY_DSN=
